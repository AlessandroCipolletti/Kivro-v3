// Kivro domain schema — Master Spec §23, §120, §308
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkerDeviceStatus {
  PAIRED
  ONLINE
  OFFLINE
  REVOKED
}

enum CapabilityStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum CapabilityScheduleMode {
  ALWAYS_AVAILABLE
  CUSTOM_SCHEDULE
  MANUALLY_PAUSED
}

enum LocalWorkerBindingStatus {
  ACTIVE
  INACTIVE
}

enum JobPaymentFunding {
  PREPAID_CREDITS
  CARD_AUTHORIZATION
}

enum JobStatus {
  CREATED
  PAYMENT_RESERVED
  SCHEDULED
  QUEUED
  DISPATCHED
  ACCEPTED
  STARTING
  RUNNING
  PAUSE_REQUESTED
  PAUSED
  RESUME_REQUESTED
  SECURITY_PAUSED
  UPLOADING_RESULT
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
  FAILED_STARTUP
  FAILED_POLICY
  FAILED_EXECUTION
  TIMED_OUT
  WORKER_OFFLINE
  RESULT_REJECTED
  REFUNDED
}

enum LedgerEntryType {
  CREDIT_PURCHASE
  JOB_RESERVE
  JOB_RELEASE
  JOB_CAPTURE
  SELLER_EARNING
  PLATFORM_FEE
  REFUND
  PAYOUT
}

enum AuditEventActor {
  BUYER
  SELLER
  WORKER
  SYSTEM
  ADMIN
}

enum StoredAssetPurpose {
  CAPABILITY_PACKAGE
  SKILL_BUNDLE
  EXAMPLE_INPUT
  BUYER_JOB_INPUT
  JOB_DELIVERABLE
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String?
  emailVerifiedAt            DateTime?
  status                     UserStatus @default(ACTIVE)
  marketplaceTermsAcceptedAt DateTime?
  stripeCustomerId           String?   @unique
  defaultPaymentMethodId     String?
  billingCountry             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sellerProfile           SellerProfile?
  jobsAsBuyer             Job[]                    @relation("BuyerJobs")
  ledgerEntries           LedgerEntry[]
  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  workerPairingCodes      WorkerPairingCode[]
  buyerStoredAssets       StoredAsset[]
  favorites               Favorite[]
  capabilityReviews       CapabilityReview[]
  marketplaceConversations MarketplaceConversation[]
  orchestrationPlans      OrchestrationPlan[]
  buyerApiKeys            BuyerApiKey[]
  buyerApiKeyAuditEvents  BuyerApiKeyAuditEvent[]
  buyerWebhookEndpoints   BuyerWebhookEndpoint[]
  apiIdempotencyRecords   ApiIdempotencyRecord[]
  abuseReports            AbuseReport[]
  buyerSubmissionRateBuckets BuyerSubmissionRateBucket[]
  buyerExecutionQuotes      BuyerExecutionQuote[]
  buyerNotifyTerminalEmail       Boolean @default(true)
  buyerNotifyScheduledReminder   Boolean @default(true)
  buyerNotifyRetentionReminder   Boolean @default(true)
  jobResultAcknowledgements      JobResultAcknowledgement[]
  jobDeliveryProblemReports      JobDeliveryProblemReport[]
}

enum MarketplaceMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OrchestrationPlanStatus {
  DRAFT
  AWAITING_APPROVAL
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum OrchestrationStepStatus {
  PLANNED
  READY
  PAYMENT_RESERVED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AgentApprovalMode {
  RECOMMEND_ONLY
  APPROVE_PLAN
}

model MarketplaceConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages MarketplaceMessage[]
  plans    OrchestrationPlan[]

  @@index([userId])
}

model MarketplaceMessage {
  id             String                 @id @default(uuid())
  conversationId String
  role           MarketplaceMessageRole
  content        Json
  createdAt      DateTime               @default(now())

  conversation MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model OrchestrationPlan {
  id                  String                  @id @default(uuid())
  userId              String
  conversationId      String?
  goal                String
  constraintsJson     Json
  maxBudgetCents      Int?
  estimatedCostCents  Int
  status              OrchestrationPlanStatus @default(DRAFT)
  approvalMode        AgentApprovalMode       @default(APPROVE_PLAN)
  approvedAt                 DateTime?
  budgetReservedCents        Int                     @default(0)
  approvedEstimatedCostCents Int?
  synthesisSummary           String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation MarketplaceConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps        OrchestrationStep[]

  @@index([userId])
  @@index([conversationId])
}

model OrchestrationStep {
  id                   String                  @id @default(uuid())
  planId               String
  sortOrder            Int
  label                String
  capabilityId         String
  capabilityVersionId  String
  dependsOnStepIds     Json                    @default("[]")
  inputMappingJson     Json?
  estimatedPriceCents  Int
  status               OrchestrationStepStatus @default(PLANNED)
  jobId                String?
  quotedPriceCents     Int?
  outputAssetRefsJson  Json?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  plan OrchestrationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model CapabilityReview {
  id                  String   @id @default(uuid())
  jobId               String   @unique
  buyerId             String
  capabilityId        String
  capabilityVersionId String
  sellerProfileId     String
  stars               Int
  body                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  capability  Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
  @@index([sellerProfileId])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  capabilityId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, capabilityId])
  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkerPairingCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SellerProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  displayName            String
  legalNameForKyc        String?
  firstPublishedAt       DateTime?
  sellerOnboarding       Json?
  payoutStatus           String   @default("NOT_STARTED")
  verificationStatus     String   @default("UNVERIFIED")
  ratingSummary          Json?
  stripeConnectedAccountId String? @unique
  connectOnboardingStatus  String?
  transfersCapabilityStatus String?
  payoutsEnabled         Boolean  @default(false)
  marketplaceEmergencyPause      Boolean   @default(false)
  marketplaceEmergencyPausedAt   DateTime?
  marketplaceEmergencyPauseSource String?
  platformSecurityPause          Boolean   @default(false)
  platformSecurityPauseReason    String?
  platformSecurityPausedAt       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerDevices WorkerDevice[]
  capabilities  Capability[]
  storedAssets  StoredAsset[]
  permissionConsents PermissionConsentRecord[]
  transferRecords SellerTransferRecord[]
}

model WorkerDevice {
  id              String             @id @default(uuid())
  sellerProfileId String
  publicKey       String
  name            String
  platform        String
  workerVersion   String
  openClawVersion String?
  status          WorkerDeviceStatus @default(PAIRED)
  lastSeenAt      DateTime?
  lastHealthReport Json?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  sellerProfile SellerProfile         @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  bindings      LocalWorkerBinding[]
  jobs          Job[]
  auditEvents   AuditEvent[]
  permissionConsents PermissionConsentRecord[]
  healthEvents  WorkerHealthEvent[]

  @@index([sellerProfileId])
}

model WorkerHealthEvent {
  id             String   @id @default(uuid())
  workerDeviceId String
  eventType      String
  severity       String
  summary        String
  payload        Json?
  createdAt      DateTime @default(now())

  workerDevice WorkerDevice @relation(fields: [workerDeviceId], references: [id], onDelete: Cascade)

  @@index([workerDeviceId, createdAt(sort: Desc)])
}

model Capability {
  id                String           @id @default(uuid())
  sellerProfileId   String
  slug              String
  name              String
  description       String
  status            CapabilityStatus @default(DRAFT)
  currentVersionId  String?          @unique
  priceTierCents    Int?
  priceTierId       String?
  currency          String           @default("USD")
  estimatedDuration Int?
  marketplaceCategory String         @default("general")
  rating            Float?
  jobCount          Int              @default(0)
  reviewCount       Int              @default(0)
  scheduleMode      CapabilityScheduleMode @default(ALWAYS_AVAILABLE)
  scheduleTimezone  String           @default("UTC")
  scheduleWindows   Json             @default("[]")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  sellerProfile   SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  versions        CapabilityVersion[] @relation("CapabilityVersions")
  currentVersion  CapabilityVersion?  @relation("CurrentCapabilityVersion", fields: [currentVersionId], references: [id])
  scheduleChanges CapabilityScheduleChange[]
  favorites       Favorite[]
  reviews         CapabilityReview[]

  @@unique([sellerProfileId, slug])
  @@index([sellerProfileId])
}

model CapabilityScheduleChange {
  id               String   @id @default(uuid())
  capabilityId     String
  sellerProfileId  String
  previousSchedule Json
  newSchedule      Json
  changedByUserId  String?
  createdAt        DateTime @default(now())

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
  @@index([sellerProfileId])
}

model CapabilityVersion {
  id                   String   @id @default(uuid())
  capabilityId         String
  versionNumber        Int
  versionLabel         String
  inputSchema          Json
  outputSchema         Json
  publicDescription    String?
  internalManifestHash String
  permissionManifest   Json
  permissionSummary    Json?
  workerManifest       Json?
  workerManifestHash   String?
  inferenceDependency  Json?
  externalProcessorsSnapshot Json @default("[]")
  dependencyGraphSnapshot Json?
  supplyChainSnapshot  Json?
  priceSnapshotCents   Int
  priceTierId          String?
  platformFeeSnapshotCents Int?
  sellerNetSnapshotCents   Int?
  currency             String   @default("USD")
  publishedAt          DateTime?
  createdAt            DateTime @default(now())

  capability          Capability           @relation("CapabilityVersions", fields: [capabilityId], references: [id], onDelete: Cascade)
  currentForCapability Capability?         @relation("CurrentCapabilityVersion")
  bindings            LocalWorkerBinding[]
  jobs                Job[]
  packageAssets       CapabilityVersionAsset[]
  permissionConsents  PermissionConsentRecord[]

  @@unique([capabilityId, versionNumber])
  @@index([capabilityId])
}

model StoredAsset {
  id                String             @id @default(uuid())
  sellerProfileId   String?
  buyerId           String?
  purpose           StoredAssetPurpose
  bucket            String
  objectKey         String
  contentHash       String
  sizeBytes         BigInt
  mimeType          String?
  uploadConfirmedAt DateTime?
  retentionExpiresAt DateTime?
  createdAt         DateTime           @default(now())

  sellerProfile SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  buyer         User?          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  versionLinks  CapabilityVersionAsset[]

  @@unique([bucket, objectKey])
  @@index([sellerProfileId])
  @@index([buyerId])
}

model CapabilityVersionAsset {
  id                  String @id @default(uuid())
  capabilityVersionId String
  storedAssetId       String
  role                String

  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id], onDelete: Cascade)
  storedAsset       StoredAsset       @relation(fields: [storedAssetId], references: [id], onDelete: Cascade)

  @@unique([capabilityVersionId, storedAssetId])
}

model PermissionConsentRecord {
  id                  String   @id @default(uuid())
  sellerProfileId     String
  workerDeviceId      String?
  capabilityVersionId String
  permissionType      String
  permissionValue     String
  manifestHash        String
  approvedAt          DateTime @default(now())

  sellerProfile     SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id], onDelete: Cascade)
  workerDevice      WorkerDevice?     @relation(fields: [workerDeviceId], references: [id])

  @@index([capabilityVersionId])
  @@index([sellerProfileId])
}

model LocalWorkerBinding {
  id                  String                   @id @default(uuid())
  capabilityVersionId String
  workerDeviceId      String
  localWorkerId       String
  status              LocalWorkerBindingStatus @default(ACTIVE)
  createdAt           DateTime                 @default(now())

  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id], onDelete: Cascade)
  workerDevice      WorkerDevice      @relation(fields: [workerDeviceId], references: [id], onDelete: Cascade)

  @@unique([capabilityVersionId, workerDeviceId])
}

model Job {
  id                         String    @id @default(uuid())
  buyerId                    String
  capabilityId               String
  capabilityVersionId        String
  versionNumber              Int
  permissionManifestSnapshot Json
  inputContractSnapshot      Json
  outputContractSnapshot     Json
  priceSnapshotCents         Int
  priceTierId                String?
  platformFeeSnapshotCents   Int?
  sellerNetSnapshotCents     Int?
  currency                   String    @default("USD")
  status                     JobStatus @default(CREATED)
  reservedAmountCents        Int?
  paymentFunding             JobPaymentFunding @default(PREPAID_CREDITS)
  stripePaymentIntentId      String?           @unique
  workerDeviceId             String?
  executionControlPlaneId    String?
  correlationId              String?
  failureCode                String?
  activeControlCommandId     String?
  pauseSupportMode           String?
  pauseRequestedAt           DateTime?
  pausedAt                   DateTime?
  resumedAt                  DateTime?
  pauseDeadlineAt            DateTime?
  securityPauseReason        String?
  dispatchExpiresAt            DateTime?
  sellerGlobalPauseAtSubmit  Boolean   @default(false)
  scheduledRunAt             DateTime?
  scheduleWaitDeadlineAt     DateTime?
  scheduleAdjustedAt         DateTime?
  orchestrationStepId        String?
  buyerApiKeyId              String?
  createdAt                  DateTime  @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?
  resultRetentionExpiresAt   DateTime?
  buyerHardDeadlineAt        DateTime?
  scheduledReminderSentAt         DateTime?
  resultRetentionReminderSentAt   DateTime?
  executionQuoteId                String?   @unique
  updatedAt                       DateTime  @updatedAt

  buyer             User              @relation("BuyerJobs", fields: [buyerId], references: [id])
  executionQuote    BuyerExecutionQuote? @relation(fields: [executionQuoteId], references: [id])
  buyerApiKey       BuyerApiKey?      @relation(fields: [buyerApiKeyId], references: [id])
  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id])
  workerDevice      WorkerDevice?     @relation(fields: [workerDeviceId], references: [id])
  attempts          JobAttempt[]
  input             JobInput?
  result            JobResult?
  transitions       JobStateTransition[]
  checkpoints       JobCheckpoint[]
  ledgerEntries     LedgerEntry[]
  auditEvents       AuditEvent[]
  sellerTransfer    SellerTransferRecord?
  review            CapabilityReview?
  terminalNotification   JobTerminalNotification?
  resultAcknowledgement  JobResultAcknowledgement?
  deliveryProblemReports JobDeliveryProblemReport[]

  @@index([buyerId])
  @@index([capabilityVersionId])
  @@index([status])
  @@index([executionControlPlaneId])
  @@index([status, scheduledRunAt])
  @@index([orchestrationStepId])
  @@index([resultRetentionExpiresAt])
}

model BuyerExecutionQuote {
  id                     String    @id @default(uuid())
  buyerId                String
  capabilityId           String
  capabilityVersionId    String
  versionNumber          Int
  priceSnapshotCents     Int
  currency               String    @default("USD")
  inputsDigest           String
  hardDeliveryDeadlineAt DateTime?
  scheduledRunAt         DateTime?
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime  @default(now())

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  job   Job?

  @@index([buyerId])
  @@index([capabilityId])
  @@index([expiresAt])
}

model JobResultAcknowledgement {
  id        String   @id @default(uuid())
  jobId     String   @unique
  buyerId   String
  kind      String   @default("LOOKS_GOOD")
  createdAt DateTime @default(now())

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

model JobDeliveryProblemReport {
  id               String   @id @default(uuid())
  jobId            String
  reporterUserId   String
  reason           String
  details          String?
  evidenceSnapshot Json
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())

  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status, createdAt(sort: Desc)])
}

model JobTerminalNotification {
  id        String   @id @default(uuid())
  jobId     String   @unique
  channel   String
  status    String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
}

model JobAttempt {
  id            String    @id @default(uuid())
  jobId         String
  attemptNumber Int
  status        JobStatus
  startedAt     DateTime?
  endedAt       DateTime?
  failureCode   String?
  createdAt     DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
}

model JobInput {
  id              String   @id @default(uuid())
  jobId           String   @unique
  structuredInput Json
  assetManifest   Json?
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobResult {
  id              String   @id @default(uuid())
  jobId           String   @unique
  structuredOutput Json?
  outputAssetManifest Json?
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobCheckpoint {
  id            String   @id @default(uuid())
  jobId         String
  attemptNumber Int
  stageLabel    String
  checkpointKey String
  recordedAt    DateTime @default(now())
  payload       Json?
  createdAt     DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@unique([jobId, checkpointKey, attemptNumber])
}

model JobStateTransition {
  id            String          @id @default(uuid())
  jobId         String
  fromStatus    JobStatus?
  toStatus      JobStatus
  actor         AuditEventActor
  reason        String?
  attemptNumber Int?
  correlationId String?
  createdAt     DateTime        @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  userId         String
  jobId          String?
  idempotencyKey String          @unique
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("USD")
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job? @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
}

model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
}

model SellerTransferRecord {
  id               String   @id @default(uuid())
  jobId            String   @unique
  sellerProfileId  String
  amountCents      Int
  currency         String   @default("USD")
  stripeTransferId String?
  status           String   @default("PENDING")
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  job           Job           @relation(fields: [jobId], references: [id])
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id])

  @@index([sellerProfileId])
}

model AuditEvent {
  id               String          @id @default(uuid())
  jobId            String?
  workerDeviceId   String?
  type             String
  actor            AuditEventActor
  correlationId    String?
  sanitizedPayload Json
  createdAt        DateTime        @default(now())

  job          Job?          @relation(fields: [jobId], references: [id])
  workerDevice WorkerDevice? @relation(fields: [workerDeviceId], references: [id])

  @@index([jobId])
}

model BuyerApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  prefix     String    @unique
  secretHash String
  scopes     Json
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]
  rateBuckets BuyerApiRateBucket[]
  auditEvents BuyerApiKeyAuditEvent[]

  @@index([userId])
}

model BuyerApiRateBucket {
  id          String   @id @default(uuid())
  apiKeyId    String
  windowStart DateTime
  count       Int      @default(0)

  apiKey BuyerApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowStart])
  @@index([windowStart])
}

model BuyerApiKeyAuditEvent {
  id        String   @id @default(uuid())
  apiKeyId  String
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  apiKey BuyerApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([userId])
}

model ApiIdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  apiKeyId       String?
  endpoint       String
  idempotencyKey String
  requestHash    String
  responseJson   Json
  statusCode     Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, idempotencyKey])
  @@index([expiresAt])
}

model BuyerWebhookEndpoint {
  id              String    @id @default(uuid())
  userId          String
  url             String
  secretEncrypted String
  events          Json
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  failureCount    Int       @default(0)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDeliveryAttempt[]

  @@index([userId])
}

model WebhookDeliveryAttempt {
  id            String    @id @default(uuid())
  endpointId    String
  eventId       String
  eventType     String
  statusCode    Int?
  success       Boolean
  error         String?
  payloadJson   Json?
  attemptCount  Int       @default(1)
  nextRetryAt   DateTime?
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime  @default(now())

  endpoint BuyerWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt(sort: Desc)])
  @@index([nextRetryAt])
  @@unique([endpointId, eventId])
}

model AbuseDenylistPattern {
  id        String   @id @default(uuid())
  pattern   String   @unique
  category  String   @default("GENERIC")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AbuseReport {
  id             String   @id @default(uuid())
  reporterUserId String
  targetType     String
  targetId       String
  capabilityId   String?
  reason         String
  details        String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterUserId])
}

model BuyerSubmissionRateBucket {
  id          String   @id @default(uuid())
  userId      String
  windowStart DateTime
  jobCount    Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowStart])
  @@index([windowStart])
}

/// M20 — PostgreSQL-backed durable async work (Netsons cron profile, HOST-NET-010).
model DurableWorkItem {
  id             String    @id @default(uuid())
  kind           String
  idempotencyKey String
  payloadJson    Json
  status         String    @default("PENDING")
  runAt          DateTime  @default(now())
  claimToken     String?
  claimedAt      DateTime?
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(8)
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([kind, idempotencyKey])
  @@index([status, runAt])
}

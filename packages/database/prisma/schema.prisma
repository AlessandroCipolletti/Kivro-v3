// Kivro domain schema — Master Spec §23, §120, §308
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkerDeviceStatus {
  PAIRED
  ONLINE
  OFFLINE
  REVOKED
}

enum CapabilityStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum LocalWorkerBindingStatus {
  ACTIVE
  INACTIVE
}

enum JobStatus {
  CREATED
  PAYMENT_RESERVED
  QUEUED
  DISPATCHED
  ACCEPTED
  STARTING
  RUNNING
  UPLOADING_RESULT
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
  FAILED_STARTUP
  FAILED_POLICY
  FAILED_EXECUTION
  TIMED_OUT
  WORKER_OFFLINE
  RESULT_REJECTED
  REFUNDED
}

enum LedgerEntryType {
  CREDIT_PURCHASE
  JOB_RESERVE
  JOB_RELEASE
  JOB_CAPTURE
  SELLER_EARNING
  PLATFORM_FEE
  REFUND
  PAYOUT
}

enum AuditEventActor {
  BUYER
  SELLER
  WORKER
  SYSTEM
  ADMIN
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String?
  emailVerifiedAt            DateTime?
  status                     UserStatus @default(ACTIVE)
  marketplaceTermsAcceptedAt DateTime?
  stripeCustomerId           String?   @unique
  defaultPaymentMethodId     String?
  billingCountry             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sellerProfile SellerProfile?
  jobsAsBuyer   Job[]          @relation("BuyerJobs")
  ledgerEntries LedgerEntry[]
}

model SellerProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  displayName            String
  payoutStatus           String   @default("NOT_STARTED")
  verificationStatus     String   @default("UNVERIFIED")
  ratingSummary          Json?
  stripeConnectedAccountId String? @unique
  connectOnboardingStatus  String?
  transfersCapabilityStatus String?
  payoutsEnabled         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerDevices WorkerDevice[]
  capabilities  Capability[]
}

model WorkerDevice {
  id              String             @id @default(uuid())
  sellerProfileId String
  publicKey       String
  name            String
  platform        String
  workerVersion   String
  openClawVersion String?
  status          WorkerDeviceStatus @default(PAIRED)
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  sellerProfile SellerProfile         @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  bindings      LocalWorkerBinding[]
  jobs          Job[]
  auditEvents   AuditEvent[]

  @@index([sellerProfileId])
}

model Capability {
  id                String           @id @default(uuid())
  sellerProfileId   String
  slug              String
  name              String
  description       String
  status            CapabilityStatus @default(DRAFT)
  currentVersionId  String?          @unique
  priceTierCents    Int?
  currency          String           @default("USD")
  estimatedDuration Int?
  rating            Float?
  jobCount          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  sellerProfile   SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  versions        CapabilityVersion[] @relation("CapabilityVersions")
  currentVersion  CapabilityVersion?  @relation("CurrentCapabilityVersion", fields: [currentVersionId], references: [id])

  @@unique([sellerProfileId, slug])
  @@index([sellerProfileId])
}

model CapabilityVersion {
  id                   String   @id @default(uuid())
  capabilityId         String
  versionNumber        Int
  versionLabel         String
  inputSchema          Json
  outputSchema         Json
  publicDescription    String?
  internalManifestHash String
  permissionManifest   Json
  permissionSummary    Json?
  priceSnapshotCents   Int
  currency             String   @default("USD")
  publishedAt          DateTime?
  createdAt            DateTime @default(now())

  capability          Capability           @relation("CapabilityVersions", fields: [capabilityId], references: [id], onDelete: Cascade)
  currentForCapability Capability?         @relation("CurrentCapabilityVersion")
  bindings            LocalWorkerBinding[]
  jobs                Job[]

  @@unique([capabilityId, versionNumber])
  @@index([capabilityId])
}

model LocalWorkerBinding {
  id                  String                   @id @default(uuid())
  capabilityVersionId String
  workerDeviceId      String
  localWorkerId       String
  status              LocalWorkerBindingStatus @default(ACTIVE)
  createdAt           DateTime                 @default(now())

  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id], onDelete: Cascade)
  workerDevice      WorkerDevice      @relation(fields: [workerDeviceId], references: [id], onDelete: Cascade)

  @@unique([capabilityVersionId, workerDeviceId])
}

model Job {
  id                         String    @id @default(uuid())
  buyerId                    String
  capabilityId               String
  capabilityVersionId        String
  versionNumber              Int
  permissionManifestSnapshot Json
  inputContractSnapshot      Json
  outputContractSnapshot     Json
  priceSnapshotCents         Int
  currency                   String    @default("USD")
  status                     JobStatus @default(CREATED)
  reservedAmountCents        Int?
  workerDeviceId             String?
  correlationId              String?
  failureCode                String?
  createdAt                  DateTime  @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?
  updatedAt                  DateTime  @updatedAt

  buyer             User              @relation("BuyerJobs", fields: [buyerId], references: [id])
  capabilityVersion CapabilityVersion @relation(fields: [capabilityVersionId], references: [id])
  workerDevice      WorkerDevice?     @relation(fields: [workerDeviceId], references: [id])
  attempts          JobAttempt[]
  input             JobInput?
  result            JobResult?
  transitions       JobStateTransition[]
  ledgerEntries     LedgerEntry[]
  auditEvents       AuditEvent[]

  @@index([buyerId])
  @@index([capabilityVersionId])
  @@index([status])
}

model JobAttempt {
  id            String    @id @default(uuid())
  jobId         String
  attemptNumber Int
  status        JobStatus
  startedAt     DateTime?
  endedAt       DateTime?
  failureCode   String?
  createdAt     DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
}

model JobInput {
  id              String   @id @default(uuid())
  jobId           String   @unique
  structuredInput Json
  assetManifest   Json?
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobResult {
  id              String   @id @default(uuid())
  jobId           String   @unique
  structuredOutput Json?
  outputAssetManifest Json?
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobStateTransition {
  id            String          @id @default(uuid())
  jobId         String
  fromStatus    JobStatus?
  toStatus      JobStatus
  actor         AuditEventActor
  reason        String?
  attemptNumber Int?
  correlationId String?
  createdAt     DateTime        @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  userId         String
  jobId          String?
  idempotencyKey String          @unique
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("USD")
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job? @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
}

model AuditEvent {
  id               String          @id @default(uuid())
  jobId            String?
  workerDeviceId   String?
  type             String
  actor            AuditEventActor
  correlationId    String?
  sanitizedPayload Json
  createdAt        DateTime        @default(now())

  job          Job?          @relation(fields: [jobId], references: [id])
  workerDevice WorkerDevice? @relation(fields: [workerDeviceId], references: [id])

  @@index([jobId])
}

# Cloud API
PORT=3001
NODE_ENV=development
# Use port 5433 with `pnpm db:up` (docker-compose) — 5432 may be another Postgres
DATABASE_URL=postgresql://kivro:kivro@localhost:5433/kivro

# Auth (M01+)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback
WEB_APP_URL=http://localhost:3000
KIVRO_DEV_AUTH_SHORTCUTS=true
SESSION_SECRET=

# Payments (M08+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage (MinIO local — `pnpm storage:setup`)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kivro-dev
S3_ACCESS_KEY=kivro
S3_SECRET_KEY=kivrodevsecret
S3_FORCE_PATH_STYLE=true

# Worker
KIVRO_RUNTIME_ROOT=~/.kivro/runtime
KIVRO_CLOUD_URL=http://localhost:3001

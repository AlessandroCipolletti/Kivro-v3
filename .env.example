# Cloud API (use PORT=3006 if reusing a Google OAuth client registered for localhost:3006)
PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development
# Use port 5433 with `pnpm db:up` (docker-compose) — 5432 may be another Postgres
DATABASE_URL=postgresql://kivro:kivro@localhost:5433/kivro
# Docker maps Redis to this host port (default 6380 — 6379 is often taken by another Redis)
KIVRO_REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# Auth (M01+)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Google Cloud "Authorized redirect URIs" exactly (path: /api/users/auth/google/callback)
# If unset, built from API_URL (then NEXT_PUBLIC_* / KIVRO_CLOUD_URL / http://localhost:$PORT)
GOOGLE_OAUTH_REDIRECT_URI=
WEB_APP_URL=http://localhost:3000
# If 3000 is taken: WEB_DEV_PORT=3002 and WEB_APP_URL=http://localhost:3002 (dev:all may auto-pick 3001–3020)
# KIVRO_DEV_WEB_AUTO_PORT=false  # do not auto-pick another web port
# KIVRO_DEV_WEB_OPTIONAL=false  # fail dev:all when web cannot bind
# KIVRO_DEV_API_WATCH=true      # dev:all uses `api start` by default so auto-pair is not interrupted by --watch
NEXT_PUBLIC_KIVRO_API_URL=http://localhost:3001
KIVRO_DEV_AUTH_SHORTCUTS=true
SESSION_SECRET=

# Transactional email (Brevo) — verification, password reset, account confirmed
BREVO_API_KEY=
BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=1
BREVO_PASSWORD_RESET_TEMPLATE_ID=2
BREVO_ACCOUNT_CONFIRMED_TEMPLATE_ID=3
# Optional if templates define sender; required by Brevo when templates do not
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Kivro
# Brevo {{params.*}} — confirmLink, resetLink, acceptLink, workspaceName, inviterName, firstName, lastName (account confirmed: firstName, lastName). Optional: BREVO_WORKSPACE_NAME=Kivro

# Marketplace Agent platform inference (optional — deterministic fallback when unset)
# KIVRO_PLATFORM_OPENAI_API_KEY=
# KIVRO_PLATFORM_OPENAI_MODEL=gpt-4o-mini

# Payments (M08+)
KIVRO_DEV_PAYMENT_SHORTCUTS=true
KIVRO_FAKE_PAYMENT_ADAPTER=true
# KIVRO_FAKE_PAYMENT_MODE=success|insufficient_funds|declined
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KIVRO_PLATFORM_LEDGER_USER_ID=

# Object storage (MinIO local — `pnpm storage:setup`)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kivro-dev
S3_ACCESS_KEY=kivro
S3_SECRET_KEY=kivrodevsecret
S3_FORCE_PATH_STYLE=true

# Worker
# OPENCLAW_BIN=openclaw
# KIVRO_E2E_OPENCLAW=true
# KIVRO_OPENCLAW_AGENT_EXEC=false
# KIVRO_E2E_CHECK_WEB=true
# KIVRO_E2E_REQUIRE_API=true
KIVRO_RUNTIME_ROOT=~/.kivro/runtime
# Must match API_URL / PORT (Worker poll + pair)
KIVRO_CLOUD_URL=http://localhost:3001
# M19 composition root: netsons (polling, default) | aws (wss transport metadata)
# KIVRO_CLOUD_PROFILE=netsons
# Netsons cron HTTP entry (POST /platform/cron/netsons-tick)
# KIVRO_CRON_SECRET=change-me-in-production
# KIVRO_NETSONS_STAGING_URL=https://staging.example
# AWS profile (M21): EventBridge/Lambda → POST /platform/cron/aws-tick
# AWS_SQS_DURABLE_WORK_QUEUE_URL=
# AWS_REGION=us-east-1
# KIVRO_AWS_STAGING_URL=https://aws-staging.example
# KIVRO_S3_NATIVE=true
# KIVRO_AWS_UNIFIED_WEB=1
# KIVRO_DATABASE_POOL_MAX=5   # Netsons default 5; AWS profile default 10 when unset
# KIVRO_NETSONS_STANDALONE=1
# KIVRO_NETSONS_UNIFIED_WEB=1
# KIVRO_WORKER_TRANSPORT=polling   # or wss (/worker/wss WebSocket or /worker/wss/dispatch shim)
# KIVRO_DUAL_CONTROL_PLANE=1         # M19/M22: simultaneous CP transports; new jobs bind to sole ACTIVE CP
# KIVRO_WSS_DISPATCH=native          # or shim (HTTP /worker/wss/dispatch)
# KIVRO_NETSONS_CP_STATE=DRAINING
# KIVRO_AWS_CP_STATE=ACTIVE
# KIVRO_M22_STAGING_URL=https://staging.example   # optional M22 discovery smoke (verify:m22)
# M25 compatibility / Worker policy (defaults from packages/compatibility/matrix.json)
# KIVRO_MIN_SECURITY_WORKER_VERSION=0.0.0-m07
# KIVRO_LATEST_SUPPORTED_WORKER_VERSION=0.0.0-m07
# KIVRO_REVOKED_WORKER_VERSIONS=0.0.0-bad,0.0.0-compromised
# KIVRO_REQUIRE_WORKER_PROTOCOL_HEADER=1   # production: reject poll/heartbeat without protocol version
# Auto-pair dev worker as seller@kivro.local when running dev:all / worker:dev (set false to pair manually)
# KIVRO_DEV_AUTO_PAIR=false
# synthetic = API-only completion in worker:dev; openclaw = real runtime (manual §573)
KIVRO_EXECUTION_MODE=sandbox-fixture
KIVRO_SANDBOX_DRY_RUN=true
KIVRO_SANDBOX_IMAGE=kivro/openclaw-sandbox:pin-me-before-prod

# Durable job results (M29)
KIVRO_JOB_RESULT_RETENTION_DAYS=90

# Scheduling (M09)
KIVRO_SCHEDULED_MAX_WAIT_HOURS=72
KIVRO_MAX_SCHEDULED_PER_WINDOW=10

# Buyer webhooks (M13) — 64 hex chars in production; dev uses deterministic fallback when unset
# KIVRO_WEBHOOK_ENCRYPTION_KEY=

# Platform admin / dispatch (M04)
KIVRO_GLOBAL_DISPATCH_ENABLED=true
KIVRO_ADMIN_TOKEN=dev-admin-token-change-me
KIVRO_ALLOW_RUNTIME_DISPATCH_TOGGLE=true

# Abuse & failure handling (M15)
KIVRO_BUYER_MAX_JOBS_PER_HOUR=40
KIVRO_WORKER_LOST_GRACE_MS=120000
KIVRO_ABUSE_AUTO_PAUSE_REPORTS=5

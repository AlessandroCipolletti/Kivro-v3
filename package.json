{
  "name": "kivro",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run build && pnpm -r run typecheck",
    "lint": "pnpm -r run lint && node scripts/check-architecture.mjs",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "node scripts/wait-for-postgres.mjs",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @kivro/database exec prisma migrate deploy",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @kivro/database exec prisma generate",
    "db:setup": "pnpm db:up && pnpm db:wait && pnpm db:migrate",
    "dev:setup": "node scripts/run-with-env.mjs node scripts/dev-setup.mjs",
    "dev": "node scripts/run-with-env.mjs node scripts/dev.mjs",
    "storage:up": "docker compose up -d minio",
    "storage:init": "node scripts/run-with-env.mjs node scripts/init-minio-bucket.mjs",
    "storage:setup": "pnpm storage:up && sleep 2 && pnpm storage:init",
    "verify:m03": "node scripts/run-with-env.mjs node scripts/verify-m03-flow.mjs",
    "verify:m04": "node scripts/run-with-env.mjs node scripts/verify-m04-flow.mjs",
    "verify:m05": "node scripts/run-with-env.mjs node scripts/verify-m05-flow.mjs",
    "verify:m06": "node scripts/run-with-env.mjs node scripts/verify-m06-flow.mjs",
    "verify:m07": "node scripts/run-with-env.mjs node scripts/verify-m07-flow.mjs",
    "verify:m08": "node scripts/run-with-env.mjs node scripts/verify-m08-flow.mjs",
    "verify:m09": "node scripts/run-with-env.mjs node scripts/verify-m09-flow.mjs",
    "verify:m10": "node scripts/run-with-env.mjs node scripts/verify-m10-flow.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "type": "module"
}

{
  "name": "kivro",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run build && pnpm -r run typecheck",
    "lint": "pnpm -r run lint && node scripts/check-architecture.mjs",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "node scripts/wait-for-postgres.mjs",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @kivro/database exec prisma migrate deploy",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @kivro/database exec prisma generate",
    "db:setup": "pnpm db:up && pnpm db:wait && pnpm db:migrate",
    "dev:setup": "node scripts/run-with-env.mjs node scripts/dev-setup.mjs",
    "dev": "node scripts/run-with-env.mjs node scripts/dev.mjs",
    "dev:all": "node scripts/run-with-env.mjs node scripts/dev-local-all.mjs",
    "dev:all:demo": "node scripts/run-with-env.mjs node scripts/dev-local-all.mjs --seed",
    "storage:up": "docker compose up -d minio",
    "storage:init": "node scripts/run-with-env.mjs node scripts/init-minio-bucket.mjs",
    "storage:setup": "pnpm storage:up && sleep 2 && pnpm storage:init",
    "verify:m03": "node scripts/run-with-env.mjs node scripts/verify-m03-flow.mjs",
    "verify:m04": "node scripts/run-with-env.mjs node scripts/verify-m04-flow.mjs",
    "verify:m05": "node scripts/run-with-env.mjs node scripts/verify-m05-flow.mjs",
    "verify:m06": "node scripts/run-with-env.mjs node scripts/verify-m06-flow.mjs",
    "verify:m07": "node scripts/run-with-env.mjs node scripts/verify-m07-flow.mjs",
    "verify:m08": "node scripts/run-with-env.mjs node scripts/verify-m08-flow.mjs",
    "verify:m09": "node scripts/run-with-env.mjs node scripts/verify-m09-flow.mjs",
    "verify:m10": "node scripts/run-with-env.mjs node scripts/verify-m10-flow.mjs",
    "verify:m11": "node scripts/run-with-env.mjs node scripts/verify-m11-flow.mjs",
    "verify:m12": "node scripts/run-with-env.mjs node scripts/verify-m12-flow.mjs",
    "verify:m13": "node scripts/run-with-env.mjs node scripts/verify-m13-flow.mjs",
    "verify:m14": "node scripts/run-with-env.mjs node scripts/verify-m14-flow.mjs",
    "verify:m15": "node scripts/run-with-env.mjs node scripts/verify-m15-flow.mjs",
    "verify:m16": "node scripts/run-with-env.mjs node scripts/verify-m16-flow.mjs",
    "verify:m17": "node scripts/run-with-env.mjs node scripts/verify-m17-flow.mjs",
    "verify:m18": "node scripts/run-with-env.mjs node scripts/verify-m18-flow.mjs",
    "verify:m19": "node scripts/run-with-env.mjs node scripts/verify-m19-flow.mjs",
    "verify:m20": "node scripts/run-with-env.mjs node scripts/verify-m20-flow.mjs",
    "verify:m21": "node scripts/run-with-env.mjs node scripts/verify-m21-flow.mjs",
    "verify:m22": "node scripts/run-with-env.mjs node scripts/verify-m22-flow.mjs",
    "verify:m23": "node scripts/run-with-env.mjs node scripts/verify-m23-flow.mjs",
    "verify:m24": "node scripts/run-with-env.mjs node scripts/verify-m24-flow.mjs",
    "verify:m25": "node scripts/run-with-env.mjs node scripts/verify-m25-flow.mjs",
    "verify:m26": "node scripts/run-with-env.mjs node scripts/verify-m26-flow.mjs",
    "verify:m27": "node scripts/run-with-env.mjs node scripts/verify-m27-flow.mjs",
    "verify:m28": "node scripts/run-with-env.mjs node scripts/verify-m28-flow.mjs",
    "verify:m29": "node scripts/run-with-env.mjs node scripts/verify-m29-flow.mjs",
    "verify:m30": "node scripts/run-with-env.mjs node scripts/verify-m30-flow.mjs",
    "verify:m31": "node scripts/run-with-env.mjs node scripts/verify-m31-flow.mjs",
    "dev:doctor": "node scripts/run-with-env.mjs node scripts/local-dev-doctor.mjs",
    "test:m18:preflight": "node scripts/run-with-env.mjs node scripts/run-m18-local-preflight.mjs",
    "worker:dev": "node scripts/run-with-env.mjs node scripts/worker-dev.mjs",
    "dev:demo": "node scripts/run-with-env.mjs node scripts/dev-demo.mjs",
    "test:e2e:local": "node scripts/run-with-env.mjs node scripts/test-e2e-local.mjs"
  },
  "devDependencies": {
    "@kivro/compatibility": "workspace:*",
    "@kivro/resilience": "workspace:*",
    "@kivro/release-ops": "workspace:*",
    "@kivro/auth": "workspace:*",
    "@kivro/billing": "workspace:*",
    "@kivro/database": "workspace:*",
    "@aws-sdk/client-s3": "^3.750.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "hono": "^4.6.14",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
